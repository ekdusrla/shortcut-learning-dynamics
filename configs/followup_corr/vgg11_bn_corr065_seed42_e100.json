{
  "dataset": "colored_mnist",
  "model": "vgg11_bn",
  "epochs": 100,
  "seed": 42,
  "image_size": 64,
  "train_corr": 0.65,
  "val_corr": 0.5,
  "test_corr": 0.5,
  "mnist_val_size": 5000,
  "color_mode": "foreground",
  "color_pairing": "next",
  "waterbirds_root": "data/raw",
  "pretrained": false,
  "augment": false,
  "lr": 0.01,
  "momentum": 0.9,
  "scheduler": "none",
  "optimizer": "sgd",
  "weight_decay": 0.0001,
  "batch_size": 128,
  "num_workers": 4,
  "features_per_group": 32,
  "amp": true,
  "save_features": true
}